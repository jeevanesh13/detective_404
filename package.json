{
  "name": "deductive-404",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:player": "vite",
    "dev:admin": "vite --config vite.admin.config.js",
    "build": "vite build && vite build --config vite.admin.config.js",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.admin.config.js",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "test": "node server/smoke.js",
    "test:pg": "node server/smoke.js --pg",
    "test:mongo": "node server/smoke.js --mongo",
    "test:all": "node server/smoke.js && node server/smoke.js --pg && node server/smoke.js --mongo"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^4.2.1",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true
  }
}
